# ==========================================
# NUVIO GROWTH BOT - ENVIRONMENT VARIABLES
# ==========================================

# Application
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=generate-a-very-secure-32-byte-secret-key-for-jwt-signing
ENCRYPTION_KEY=dGVzdF9mZXJuZXRfa2V5XzMyX2J5dGVzX2FkZGFkZGFkZGFkZGE=
PORT=8000

# Database
# Local SQLite: sqlite:///./nuviabot.db
# Production PostgreSQL: postgresql+psycopg2://user:password@localhost:5432/nuviabot
DATABASE_URL=sqlite:///./nuviabot.db

# OpenAI API Key (Content Studio & Multi-language AI Copywriter)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Meta Graph API (Instagram & Facebook)
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:8000/api/v1/social/callback/meta

# TikTok Content Posting API
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:8000/api/v1/social/callback/tiktok

# Google / YouTube Data API v3
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/social/callback/youtube

# Stripe Subscriptions & Billing
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Storage & Uploads
STORAGE_TYPE=local
UPLOAD_DIR=/Users/wisly/nuviobot/nuviabot/app/static/uploads
MAX_UPLOAD_SIZE_BYTES=52428800

# Rate Limiting & Defaults
RATE_LIMIT_PER_MINUTE=120
DEFAULT_LANGUAGE=es
DEFAULT_TIMEZONE=America/New_York

